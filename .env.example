# Local backend defaults. Run uvicorn from the backend directory.
SECRET_KEY=replace-with-a-long-random-value-before-deploying
DATABASE_URL=sqlite:///./resume_screening.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
ACCESS_TOKEN_MINUTES=720

# Optional OpenAI-compatible chat completions endpoint. Leave unset for deterministic local summaries.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Optional; install backend/requirements-ml.txt and set true to use cached sentence-transformer embeddings.
USE_SENTENCE_TRANSFORMERS=false
